# Backend database connection used by FastAPI, SQLAlchemy, and Alembic.
DATABASE_URL="postgresql+psycopg://meeteat:meeteat@localhost:5432/meeteat"

# Comma-separated frontend origins allowed to call the backend.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend API base URL.
VITE_API_BASE_URL="http://localhost:8000"

# Optional server-side Z.AI / GLM key for grounded recommendation explanations.
# Leave unset to use deterministic fallback reasons only.
ZAI_API_KEY=""
